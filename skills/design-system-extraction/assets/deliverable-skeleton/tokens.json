{
  "name": "<brand>",
  "version": "1.0",
  "note": "TEMPLATE: structure example only. Every value (#000000, 0px, 0, 0ms) and every <...> name is a placeholder; replace all of them from the run's data. `css.prefix` is required; the `tailwind` block is optional theme naming (omit a key to keep the generator's default; breakpoint variants come from the breakpoint-<step> token names, so add `breakpoints` only for tokens named otherwise; `text_shadow` stays {} when the brand has no text shadow). In a Phase 1 snapshot every entry has origin source, and role colors hold their literal values instead of aliases. Delete these sentences and write the file's own note.",
  "reference": {
    "alias": "A value written {name} refers to another token by name.",
    "css": "tokens.css is generated from this file; each token becomes --<prefix>-<name>.",
    "direction": "primitive <- semantic <- component: components reference semantic or component tokens; semantic tokens reference primitives.",
    "breakpoints": "Breakpoint tokens are reference values; media queries use the literal numbers."
  },
  "css": {
    "prefix": "<prefix>"
  },
  "tailwind": {
    "shadow_names": { "focus-ring": "focus" },
    "text_shadow": { "<text-shadow token>": "<theme name>" },
    "container_prefixes": ["size-layout-"],
    "spacing_token": "space-<n>"
  },
  "themes": [
    { "id": "<theme-id>", "name": "<theme name>" }
  ],
  "color": {
    "note": "<family note>",
    "tokens": [
      { "name": "palette-<family>-<step>", "value": "#000000", "tier": "primitive", "origin": "source", "usage": "<step; referenced by; ratio on white>" },
      { "name": "palette-<family>-alpha-<pct>", "value": "rgba(0, 0, 0, 0)", "tier": "primitive", "origin": "source", "usage": "<base color and opacity>" },
      { "name": "color-text-<role>", "value": "{palette-<family>-<step>}", "tier": "semantic", "origin": "source", "usage": "<purpose; surfaces and ratios; components>" },
      { "name": "color-surface-<role>", "value": "{palette-<family>-<step>}", "tier": "semantic", "origin": "source", "usage": "<purpose>" },
      { "name": "color-focus-ring", "value": "{palette-<family>-<step>}", "tier": "semantic", "origin": "added", "usage": "<added state; ratio against each surface>" },
      { "name": "<component>-<part>-<property>", "value": "{palette-<family>-<step>}", "tier": "component", "component": "<component>", "origin": "source", "usage": "<component-only value; contrast; used by>" }
    ]
  },
  "type": {
    "families": {
      "<family-key>": { "value": "\"<Family Name>\", <fallback>, sans-serif", "tier": "primitive", "origin": "source", "usage": "Not bundled; the project loads it." }
    },
    "scales": {
      "font-family": { "tokens": [] },
      "font-size": { "tokens": [ { "name": "font-size-<n>", "value": "0px", "tier": "primitive", "origin": "source", "usage": "<styles using it>" } ] },
      "line-height": { "tokens": [ { "name": "line-height-<name>", "value": "0", "tier": "primitive", "origin": "source", "usage": "<styles using it>" } ] },
      "font-weight": { "tokens": [ { "name": "font-weight-<name>", "value": "0", "tier": "primitive", "origin": "source", "usage": "<styles using it>" } ] },
      "letter-spacing": { "tokens": [ { "name": "letter-spacing-<name>", "value": "0px", "tier": "primitive", "origin": "source", "usage": "<styles using it>" } ] }
    },
    "groups": [
      {
        "name": "<role>",
        "note": "<group note>",
        "styles": [
          {
            "name": "type-<role>-<size>",
            "role": "<role>",
            "size": "<lg|md|sm>",
            "tier": "semantic",
            "origin": "source",
            "family": "{font-family-<family-key>}",
            "fontSize": "{font-size-<n>}",
            "lineHeight": "{line-height-<name>}",
            "fontWeight": "{font-weight-<name>}",
            "letterSpacing": "{letter-spacing-<name>}",
            "breakpoints": [ { "min": "breakpoint-<name>", "fontSize": "{font-size-<n>}" } ],
            "usage": "<purpose; mobile-first base is the small-screen value>"
          }
        ]
      }
    ]
  },
  "space": {
    "note": "<allowed steps>",
    "tokens": [
      { "name": "space-<n>", "value": "0px", "tier": "primitive", "origin": "source", "usage": "<where>" }
    ]
  },
  "radius": {
    "tokens": [
      { "name": "radius-<name>", "value": "0px", "tier": "primitive", "origin": "source", "usage": "<where>" },
      { "name": "radius-control", "value": "{radius-<name>}", "tier": "semantic", "origin": "source", "usage": "<where>" }
    ]
  },
  "shadow": {
    "tokens": [
      { "name": "elevation-<n>", "value": "0px 0px 0px {palette-<family>-alpha-<pct>}", "tier": "semantic", "origin": "source", "usage": "<where>" },
      { "name": "focus-ring", "value": "0 0 0 0px {color-focus-ring}", "tier": "semantic", "origin": "added", "usage": "<focus-visible ring>" }
    ]
  },
  "size": {
    "note": "<categories: control, icon, layout, component>",
    "tokens": [
      { "name": "size-control-<n>", "value": "0px", "tier": "primitive", "origin": "source", "usage": "<control height>" },
      { "name": "size-icon-<n>", "value": "0px", "tier": "primitive", "origin": "source", "usage": "<icon box>" },
      { "name": "size-layout-<name>", "value": "0px", "tier": "primitive", "origin": "source", "usage": "<container max width at a breakpoint>" }
    ]
  },
  "duration": {
    "tokens": [
      { "name": "duration-<n>", "value": "0ms", "tier": "primitive", "origin": "source", "usage": "<transition>" }
    ]
  },
  "easing": {
    "tokens": [
      { "name": "easing-<name>", "value": "<timing-function>", "tier": "primitive", "origin": "source", "usage": "<transition>" }
    ]
  },
  "breakpoint": {
    "tokens": [
      { "name": "breakpoint-<name>", "value": "0px", "tier": "primitive", "origin": "source", "usage": "Reference value; media queries use the literal number." }
    ]
  }
}
